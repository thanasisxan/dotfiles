# Shared across machines. Identity (name/email, signing) lives in the
# untracked ~/.gitconfig.local so personal and work never mix.
[user]
	# Refuse to commit until ~/.gitconfig.local sets user.name/user.email
	useConfigOnly = true
[diff]
	tool = meld
[difftool]
	prompt = false
[core]
	editor = nvim
	autocrlf = input
[include]
	path = ~/.gitconfig.local
